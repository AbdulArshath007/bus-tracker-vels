# Environment Variables — Vels University Bus Tracker Backend
# Copy this file to .env and fill in real values before running.

# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed CORS origins (client app origins)
CORS_ORIGINS=http://localhost:3001,http://localhost:4200

# ─── PostgreSQL ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bustrack
DB_USER=bustrack_user
DB_PASSWORD=changeme

# ─── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# ─── S3-Compatible Storage ─────────────────────────────────────
S3_BUCKET=bustrack-attachments
S3_REGION=ap-south-1
S3_ENDPOINT=                    # Leave blank for AWS. Set for MinIO, e.g. http://localhost:9000
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
PRESIGNED_URL_TTL_SECONDS=300   # 5 minutes

# ─── Firebase Cloud Messaging ──────────────────────────────────
# Absolute path to the Firebase service account JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Rate Limiting ─────────────────────────────────────────────
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL_MS=900000       # 15 minutes in milliseconds
THROTTLE_GLOBAL_LIMIT=200
THROTTLE_GLOBAL_TTL_MS=60000      # 1 minute
THROTTLE_UPLOAD_LIMIT=20
THROTTLE_UPLOAD_TTL_MS=3600000    # 1 hour

# ─── Geofence ──────────────────────────────────────────────────
DESTINATION_GEOFENCE_RADIUS_METRES=150
BUS_APPROACHING_ETA_MINUTES=10

# ─── Seed ──────────────────────────────────────────────────────
ADMIN_EMAIL=admin@bustrack.vels.edu.in
ADMIN_PASSWORD=changeme_strong_password
ADMIN_FULL_NAME=System Administrator

# ─── Job Alerting (optional) ───────────────────────────────────
# Webhook URL for cleanup-job failure alerts (Slack or similar)
ALERT_WEBHOOK_URL=
